{
  "rootDir": "../..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["ts", "js", "json"],
  "moduleNameMapper": {
    "^src/(.*)\\.js$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"]
}
